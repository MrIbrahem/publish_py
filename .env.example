# toolforge envvars create FLASK_SECRET_KEY "......"
# ============================================================
# Flask environment
# ============================================================

# "development" | "production" | "testing"
FLASK_ENV=development
APP_ENV=development

# ============================================================
# Security (Flask 3.1+ features)
# ============================================================

# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
FLASK_SECRET_KEY=......

# Salt used alongside the secret key for derived tokens
SECRET_SALT=mdwikipy

# Comma-separated fallback secret keys for key rotation
SECRET_KEY_FALLBACKS=

# Maximum request body size in bytes (default 16MB)
MAX_CONTENT_LENGTH=16777216

# Maximum form data held in memory in bytes (default 16MB)
MAX_FORM_MEMORY_SIZE=16777216

# Maximum number of form fields per request (default 1000)
MAX_FORM_PARTS=1000

# Shared code required to authorize publishing operations
PUBLISH_SECRET_CODE=

# CSRF token lifetime in seconds (default 3600)
WTF_CSRF_TIME_LIMIT=3600

# ============================================================
# Paths / data directories
# ============================================================

# Root directory for application data
# Default: ~/data
MAIN_DIR=I:/mdwiki/publish_py/data

# Directory containing the fix_refs.py module (optional)
FIX_REFS_PY_PATH=

# Where daily publish reports are written
# Default: <MAIN_DIR>/publish_reports/reports_by_day
PUBLISH_REPORTS_DIR=

# Path to the words.json table
# Default: <MAIN_DIR>/td/Tables/jsons/words.json
WORDS_JSON_PATH=

# Path to the cached all-pages revids JSON
# Default: ~/public_html/all_pages_revids.json
ALL_PAGES_REVIDS_PATH="I:/MD_TOOLS/MDWIKI_MAIN_REPO/src/public_html/all_pages_revids.json"

# Directory passed to the mdwiki category fetcher (tablesDir)
TABLES_PATH=I:/MD_TOOLS/MDWIKI_MAIN_REPO/public_html/td/Tables

# ============================================================
# Database (Toolforge toolsdb)
# ============================================================

TOOL_TOOLSDB_HOST=tools.db.svc.wikimedia.cloud
TOOL_TOOLSDB_USER=root
TOOL_TOOLSDB_PASSWORD=root11

TOOL_TOOLSDB_DBNAME=publish_py

# ============================================================
# MediaWiki OAuth
# ============================================================

OAUTH_MWURI=https://meta.wikimedia.org/w/index.php
OAUTH_CONSUMER_KEY=your_consumer_key
OAUTH_CONSUMER_SECRET=your_consumer_secret

# Generate URL-safe 32-byte Fernet key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=....

# ============================================================
# Cookies / session
# ============================================================

AUTH_COOKIE_NAME=uid_enc
AUTH_COOKIE_MAX_AGE=2592000  # 30 days
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_HTTPONLY=1

# Flask session key names
STATE_SESSION_KEY=oauth_state_nonce
REQUEST_TOKEN_SESSION_KEY=state
REQUEST_SECRET_SESSION_KEY=oauth_request_secret

# ============================================================
# CORS
# ============================================================

# Comma-separated list of allowed domains (empty → built-in defaults)
CORS_ALLOWED_DOMAINS=

# ============================================================
# Users
# ============================================================

# "alternate:canonical" pairs, comma-separated
SPECIAL_USERS=Mr. Ibrahem 1:Mr. Ibrahem,Admin:Mr. Ibrahem

# Fallback user for retry operations
FALLBACK_USER=Mr. Ibrahem

# Comma-separated users who don't get hashtags on their own pages
USERS_WITHOUT_HASHTAG=Mr. Ibrahem

# ============================================================
# new_html blueprint
# ============================================================

# Directory used to cache wikitext / html / segments per revision
REVISIONS_DIR=~/public_html/revisions_new

# Wikipedia REST API base used for wikitext → HTML transformation
TRANSFORM_BASE_URL=https://en.wikipedia.org/w/rest.php/v1

# ============================================================
# External APIs / misc
# ============================================================

USER_AGENT="My Tool/1.0 (https://tool.toolforge.org; tools.tool@toolforge.org)"
WIKI_DOMAIN=commons.wikimedia.org
STATIC_SERVER=https://tools-static.wmflabs.org/cdnjs
TOOL_TITLE=mdwikipy tools
WIKIDATA_DOMAIN=www.wikidata.org

# Default: https://mdwiki.toolforge.org/api.php
REVIDS_API_URL=http://localhost:9001/api
